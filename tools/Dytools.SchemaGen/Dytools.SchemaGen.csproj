<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer utility: regenerates deploy-config.schema.json from the config models.
       Never packed and never shipped with the tool. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SchemaGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dytools.DeployTool\Dytools.DeployTool.csproj" />
  </ItemGroup>

</Project>
